# Ethereum RPC endpoint (get free one at https://www.alchemy.com or https://infura.io)
# Mainnet
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Alternatively, use a public RPC (rate-limited but works for demo)
# ETH_RPC_URL=https://cloudflare-eth.com

# Server
PORT=3001

# Scan interval in milliseconds (default 10 seconds)
SCAN_INTERVAL_MS=10000

# Minimum profit threshold in USD to flag an opportunity
MIN_PROFIT_USD=5
