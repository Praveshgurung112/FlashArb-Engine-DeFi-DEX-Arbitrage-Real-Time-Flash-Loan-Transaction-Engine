{
  "name": "defi-arb-scanner",
  "version": "1.0.0",
  "description": "Live DEX Arbitrage Scanner & Liquidity Aggregator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "express": "^4.19.2",
    "ws": "^8.17.0",
    "concurrently": "^8.2.2"
  }
}
